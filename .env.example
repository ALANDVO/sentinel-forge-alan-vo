# Sentinel Forge — Environment Configuration
# Copy to .env and fill in blank values for local development.

# --- Server ---
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=false

# --- Database ---
DATABASE_URL=sqlite:///./sentinel_forge.db

# --- Demo Mode ---
# Local-only demo mode. Binds to 127.0.0.1 only.
# NEVER enable in production.
DEMO_MODE=true

# --- OIDC / Keycloak (planned for future round) ---
# OIDC_ISSUER_URL=https://keycloak.example.com/realms/sentinel-forge
# OIDC_CLIENT_ID=sentinel-forge
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
# KEYCLOAK_USER=
# KEYCLOAK_PASSWORD=

# --- LLM Provider (planned for future round, opt-in) ---
# LLM_API_KEY=
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://openrouter.ai/api